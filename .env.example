# Copy to .env and fill in real values. .env is git-ignored; this file is not.

# Postgres (used by docker-compose.yml and src/db.ts)
DB_USER=postgres
DB_PASSWORD=change-me
DB_NAME=adplatform
DB_HOST=localhost
DB_PORT=5432

# Shared secret: the REST API requires it, the MCP server sends it.
# Generate one with: openssl rand -hex 32
API_KEY=change-me

# Where the MCP server finds the REST API
API_BASE_URL=http://localhost:3000
